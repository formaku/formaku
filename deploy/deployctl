#!/usr/bin/env bash
# Invoked on a dedicated Linux host; runtime configuration stays on that host.
set -euo pipefail
umask 077

command=${1:-status}
cd /opt/formaku
if [[ "$command" == status ]]; then
    if (( $# <= 1 )); then
        cat release.json 2>/dev/null || echo '{"state":"not_installed"}'
        exit
    fi
    [[ $# == 2 && "$2" =~ ^[a-f0-9-]{36}$ ]] || exit 2
    # The controller atomically replaces this compact record. Compare the same snapshot we return.
    if status=$(cat release.json 2>/dev/null) && [[ "$status" == *",\"release\":\"$2\","* ]]; then
        printf '%s\n' "$status"
    else
        echo '{"state":"unavailable"}'
    fi
    exit
fi
runtime_lock_probe() (
    if [[ -e deploy.lock || -L deploy.lock ]]; then
        [[ -f deploy.lock ]] || return 1
        flock -E 75 -s -n 8 8<deploy.lock
    fi
)

runtime_can_observe() {
    local lock_result=0
    runtime_lock_probe 2>/dev/null || lock_result=$?
    case "$lock_result" in
        0) return 0 ;;
        75) printf '%s\n' '{"state":"transitioning"}' ;;
        *) printf '%s\n' '{"state":"unavailable"}' ;;
    esac
    return 1
}

runtime_file() {
    local LC_ALL=C content
    if [[ ! -e "$1" && ! -L "$1" ]]; then
        return 0
    fi
    [[ -f "$1" ]] || return 1
    content=$(head -c 4097 -- "$1" | tr '\000' '?') || return 1
    [[ ${#content} -le 4096 ]] || return 1
    printf '%s' "$content"
}

runtime_containers() {
    local image=$1 allowed=$2 expected service id details
    local details_pattern='^(sha256:[a-f0-9]{64}) (created|running|paused|restarting|removing|exited|dead) (healthy|unhealthy|starting|none)$'
    [[ "$image" =~ ^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_.-]+@sha256:[a-f0-9]{64}$ && -n "$allowed" ]] || return 1
    [[ "${image%@*}" == "$allowed" ]] || return 2

    expected=$(timeout --kill-after=1s 5s docker image inspect --format '{{.Id}}' "$image") || return 1
    [[ "$expected" =~ ^sha256:[a-f0-9]{64}$ ]] || return 1
    local -x FORMAKU_IMAGE=$image
    for service in web worker scheduler; do
        id=$(timeout --kill-after=1s 5s docker compose --env-file .env.docker ps --quiet "$service") || return 1
        [[ -n "$id" && "$id" != *$'\n'* ]] || return 2
        [[ "$id" =~ ^[a-f0-9]{12,64}$ ]] || return 1

        details=$(timeout --kill-after=1s 5s docker container inspect --format \
            '{{.Image}} {{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id") || return 1
        [[ "$details" =~ $details_pattern ]] || return 1
        [[ "${BASH_REMATCH[1]}" == "$expected" && "${BASH_REMATCH[2]}" == running ]] || return 2
        [[ "${BASH_REMATCH[3]}" != none ]] || return 1
        [[ "${BASH_REMATCH[3]}" == healthy ]] || return 2
    done
}

observe_runtime() {
    local image allowed attempt final_image final_allowed final_attempt result=0
    # Neither lock probe holds a descriptor while Docker is queried.
    runtime_can_observe || return 0
    if ! image=$(runtime_file active-image 2>/dev/null) \
        || ! allowed=$(runtime_file allowed-image 2>/dev/null) \
        || ! attempt=$(runtime_file release.json 2>/dev/null); then
        printf '%s\n' '{"state":"unavailable"}'
        return 0
    fi

    runtime_containers "$image" "$allowed" 2>/dev/null || result=$?
    if ! final_image=$(runtime_file active-image 2>/dev/null) \
        || ! final_allowed=$(runtime_file allowed-image 2>/dev/null) \
        || ! final_attempt=$(runtime_file release.json 2>/dev/null); then
        printf '%s\n' '{"state":"unavailable"}'
        return 0
    fi
    runtime_can_observe || return 0
    if [[ "$image" != "$final_image" || "$allowed" != "$final_allowed" || "$attempt" != "$final_attempt" ]]; then
        printf '%s\n' '{"state":"transitioning"}'
        return 0
    fi

    case "$result" in
        0) printf '{"state":"verified","image":"%s"}\n' "$image" ;;
        2) printf '%s\n' '{"state":"mismatch"}' ;;
        *) printf '%s\n' '{"state":"unavailable"}' ;;
    esac
}

if [[ "$command" == runtime ]]; then
    [[ $# == 1 ]] || exit 2
    observe_runtime
    exit
fi

[[ "$command" == deploy && $# == 3 ]] || { echo 'Usage: deployctl status [RELEASE_UUID] | runtime | deploy IMAGE@sha256:DIGEST RELEASE_UUID' >&2; exit 2; }
image=$2
release=$3
[[ "$image" =~ ^ghcr.io/[a-z0-9_.-]+/[a-z0-9_.-]+@sha256:[a-f0-9]{64}$ ]] || exit 2
[[ "$release" =~ ^[a-f0-9-]{36}$ ]] || exit 2

exec 9>/opt/formaku/deploy.lock
flock -n 9 || { echo 'Another deployment is active' >&2; exit 1; }
[[ -f allowed-image && "${image%@*}" == "$(cat allowed-image)" ]] || exit 2
[[ -f .env.docker && -f backup.key ]] || exit 2

backup_archive="backups/$release.tar.enc"
if [[ -e "$backup_archive" || -L "$backup_archive" ]]; then
    echo 'A backup already exists for this release. Use a new release UUID.' >&2
    exit 2
fi

stage=$(mktemp -d /opt/formaku/.backup.XXXXXX)
backup_tmp=''
previous=''
stop_attempted=false
start_attempted=false
updating_markers=false
export FORMAKU_IMAGE="$image"
compose=(docker compose --env-file .env.docker)

write_status() {
    local state=$1 failure_fields=''
    if [[ "$state" == failed ]]; then
        printf -v failure_fields ',"rollback":"%s"' "$2"
        if [[ -n "$backup_tmp" && "$backup_tmp" -ef "$backup_archive" ]]; then
            printf -v failure_fields '%s,"backup":"%s"' "$failure_fields" "$release"
        fi
    fi
    printf '{"state":"%s","release":"%s","image":"%s"%s}\n' "$state" "$release" "$image" "$failure_fields" \
        > "$stage/release.json" && mv "$stage/release.json" release.json
}

restore_marker() {
    local marker=$1
    if [[ -f "$stage/$marker.old" ]]; then
        mv "$stage/$marker.old" "$marker"
    else
        rm -f "$marker"
    fi
}

cleanup() {
    local code=$? rollback=not_attempted
    trap - EXIT
    trap '' INT TERM
    if [[ "$code" != 0 ]]; then
        if [[ "$stop_attempted" == true ]]; then
            if [[ -z "$previous" ]]; then
                rollback=unavailable
                if [[ "$start_attempted" == true ]]; then
                    "${compose[@]}" stop web worker scheduler || echo 'Could not stop the unverified deployment' >&2
                fi
            elif FORMAKU_IMAGE="$previous" "${compose[@]}" up -d --no-build --wait --wait-timeout 120; then
                rollback=restored
            else
                rollback=failed
            fi
        fi
        if [[ "$updating_markers" == true ]]; then
            restore_marker previous-image || echo 'Could not restore previous-image' >&2
            restore_marker active-image || echo 'Could not restore active-image' >&2
        fi
        write_status failed "$rollback" || echo 'Could not write the failed deployment status' >&2
    fi
    if [[ -n "$backup_tmp" ]]; then
        rm -f "$backup_tmp" || true
    fi
    rm -rf "$stage" || true
    exit "$code"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

write_status deploying
for marker in active-image previous-image; do
    if [[ -f "$marker" ]]; then
        cp -p "$marker" "$stage/$marker.old"
    fi
done
if [[ -f "$stage/active-image.old" ]]; then
    previous=$(cat "$stage/active-image.old")
fi

# Pull before stopping writers; the database must stay up for the backup.
docker pull "$image"
mkdir -p backups
chmod 700 backups
backup_tmp=$(mktemp "backups/.${release}.XXXXXX")
stop_attempted=true
"${compose[@]}" stop web worker scheduler
"${compose[@]}" exec -T database sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB"' > "$stage/database.sql"
"${compose[@]}" run --rm --no-deps --user root --entrypoint tar web -C /app/storage/app -czf - . > "$stage/uploads.tar.gz"
cp .env.docker "$stage/runtime.env"
tar -C "$stage" -cf - database.sql uploads.tar.gz runtime.env \
    | openssl enc -aes-256-cbc -salt -pbkdf2 -pass file:backup.key -out "$backup_tmp"
# Publish the completed archive without replacing an existing backup.
ln "$backup_tmp" "$backup_archive"

# Only backwards-compatible migrations belong in automatic deployment releases.
"${compose[@]}" run --rm --no-deps web php artisan migrate --force
start_attempted=true
"${compose[@]}" up -d --no-build --wait --wait-timeout 120
printf '%s\n' "$previous" > "$stage/previous-image"
printf '%s\n' "$image" > "$stage/active-image"
updating_markers=true
mv "$stage/previous-image" previous-image
mv "$stage/active-image" active-image
write_status deployed
